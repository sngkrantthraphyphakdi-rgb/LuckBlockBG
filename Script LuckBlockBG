-- ตัวแปรสถานะ
local isSpamSpawn = false
local isSpeedEnabled, speedValue = false, 16
local isJumpEnabled, jumpValue = false, 50
local isFlyEnabled, flySpeed = false, 60
local isNoclipEnabled = false
local isGodModeEnabled = false
